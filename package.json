{
  "name": "pawprint-adoption",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"vite\" \"node server/index.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node server/db/migrate.ts",
    "db:seed": "node server/db/seed.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "better-auth": "^1.7.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "5.2.1",
    "lucide-react": "0.523.0",
    "pg": "^8.23.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8"
  }
}
